    "API keys are stored in your device's Keychain and are only sent to the provider they belong to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de API se guardan en el llavero de tu dispositivo y solo se envían al proveedor al que pertenecen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi API sono salvate nel portachiavi del dispositivo e vengono inviate solo al provider a cui appartengono."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-Schlüssel werden im Schlüsselbund deines Geräts gespeichert und nur an den Anbieter gesendet, zu dem sie gehören."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés API sont stockées dans le trousseau de votre appareil et ne sont envoyées qu'au fournisseur auquel elles appartiennent."
          }
        }
      }
    },
    "Apple Intelligence can't read photos on this device. Choose a cloud provider in AI provider settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence no puede leer fotos en este dispositivo. Elige un proveedor en la nube en los ajustes de proveedores de IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence non può leggere le foto su questo dispositivo. Scegli un provider cloud nelle impostazioni dei provider di IA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kann auf diesem Gerät keine Fotos lesen. Wähle in den KI-Anbieter-Einstellungen einen Cloud-Anbieter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ne peut pas lire les photos sur cet appareil. Choisissez un fournisseur cloud dans les réglages des fournisseurs d'IA."
          }
        }
      }
    },
